# Copie este arquivo para .env e preencha os valores.
# O .env fica fora do Git. Nenhum valor real entra aqui.
# As obrigatórias derrubam o build se faltarem; as opcionais apenas desligam
# o canal que servem. O contrato é validado em functions/lib/env.ts.

# ---------------------------------------------------------------------------
# Obrigatórias
# ---------------------------------------------------------------------------

# Chat do portfólio (Ask Eric). Painel da Groq, em API Keys.
GROQ_API_KEY=

# Aviso de contato no Telegram. O token sai do BotFather, ao criar o bot.
TELEGRAM_BOT_TOKEN=
# Seu próprio ID de usuário, para onde o bot escreve.
TELEGRAM_CHAT_ID=

# Banco do formulário e do limite por IP. Upstash Redis, aba REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Opcionais: e-mail do formulário
# Sem as três o lead continua sendo gravado e avisado pelo Telegram, só não
# vira e-mail.
# ---------------------------------------------------------------------------

# Chave da Resend. Começa com re_
RESEND_API_KEY=
# Remetente. Precisa ser um endereço do domínio verificado na Resend.
CONTACT_MAIL_FROM=contato@ericlima.com.br
# Caixa que recebe o lead.
CONTACT_MAIL_TO=

# ---------------------------------------------------------------------------
# Opcionais: aviso no WhatsApp pelo CallMeBot
# Sem as duas o contato continua caindo no Telegram.
# ---------------------------------------------------------------------------

# Telefone com código do país, só dígitos.
WHATSAPP_ALERT_PHONE=
# Chave que o CallMeBot devolve depois de autorizar o número.
WHATSAPP_ALERT_APIKEY=
